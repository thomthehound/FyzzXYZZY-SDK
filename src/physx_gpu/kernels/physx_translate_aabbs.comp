#version 450

// Translation of PhysX translateAABBsLaunch from
// physx/source/gpubroadphase/src/CUDA/broadphase.cu.
// PhysX uses 256 threads per block, eight threads per AABB and six active
// components. Preserve its bit encoding and optional environment-ID mapping.
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer FloatBounds {
    float values[];
} input_bounds;

layout(std430, set = 0, binding = 1) readonly buffer ContactDistances {
    float values[];
} contact_distances;

layout(std430, set = 0, binding = 2) readonly buffer EnvironmentIds {
    uint values[];
} environment_ids;

layout(std430, set = 0, binding = 3) writeonly buffer IntegerBounds {
    uint values[];
} output_bounds;

layout(push_constant) uniform Parameters {
    uint count;
    uint shift_x;
    uint shift_y;
    uint shift_z;
    uint env_bits_x;
    uint env_bits_y;
    uint env_bits_z;
    uint env_enabled;
} parameters;

void main() {
    uint thread_index = gl_GlobalInvocationID.x;
    uint box_index = thread_index >> 3u;
    uint component = thread_index & 7u;
    if (box_index >= parameters.count || component >= 6u) {
        return;
    }

    uint axis = component < 3u ? component : component - 3u;
    uint source_index = box_index * 6u + component;
    float coordinate = input_bounds.values[source_index];
    float distance = contact_distances.values[box_index];
    float projected = component < 3u ? coordinate - distance : coordinate + distance;

    uint bits = floatBitsToUint(projected);
    uint encoded = (bits & 0x80000000u) != 0u ? ~bits : (bits | 0x80000000u);
    uint shift = axis == 0u ? parameters.shift_x :
                 (axis == 1u ? parameters.shift_y : parameters.shift_z);
    uint env_shift = axis == 0u ? parameters.env_bits_x :
                     (axis == 1u ? parameters.env_bits_y : parameters.env_bits_z);
    uint mask = component >= 3u ? 1u : 0u;
    uint out_value = ((encoded >> shift) & ~1u) | mask;

    if (parameters.env_enabled != 0u && env_shift != 0u) {
        uint env_id = environment_ids.values[box_index];
        if (env_id != 0xffffffffu) {
            out_value |= env_id << (32u - env_shift);
        } else {
            // PhysX shared environment objects span the encoded world.
            out_value = mask != 0u ? 0xfe7fffffu : 0x01800000u;
        }
    }

    output_bounds.values[source_index] = out_value;
}
